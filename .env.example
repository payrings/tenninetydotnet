# Copy to `.env` (repository root) - docker compose reads it automatically.
# Never commit the real .env; it is git-ignored.

# Directory holding the two GGUF weight files (coder.gguf, reviewer.gguf).
# See models/README.md. Absolute path recommended; ./models is the default.
TENNINETY_MODELS_DIR=./models

# llama-swap unified image for AMD Vulkan. Upstream publishes the unified
# images as nightly builds only (no release-stable tag), so this pins an
# immutable date tag together with its manifest digest - both verified against
# ghcr.io when this line was written. To move it: pick a newer date tag from
# https://github.com/mostlygeek/llama-swap/pkgs/container/llama-swap, record
# why you moved, and keep tag and digest in sync.
# (NVIDIA owners: the same compose works with e.g. ...:unified-cuda13 plus the
# NVIDIA device reservation snippet in docs/SENIOR-GUIDE.md.)
TENNINETY_LLAMA_SWAP_IMAGE=ghcr.io/mostlygeek/llama-swap:unified-vulkan-2026-09-06@sha256:0eda3af705c41c9f32113a95e3fb4c59f77158c84c3b7f1a5d8cb5cfaff1e4c2

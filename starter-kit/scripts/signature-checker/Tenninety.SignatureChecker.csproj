<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
    <!-- Roslyn needs these compile-time contracts, but MSBuildLocator must load
         every MSBuild runtime assembly from the selected SDK. Exclude each
         transitive MSBuild package explicitly because ExcludeAssets metadata
         does not flow through package dependencies. -->
    <PackageReference Include="Microsoft.Build" Version="17.11.48" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.11.48" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.11.48" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
  </ItemGroup>

  <!-- Microsoft requires locator-based applications to keep MSBuild runtime
       DLLs out of their output. Turn that deployment rule into a build gate. -->
  <Target Name="RejectBundledMSBuildRuntime" AfterTargets="Build">
    <ItemGroup>
      <_BundledMSBuildRuntime
        Include="$(TargetDir)Microsoft.Build*.dll"
        Exclude="$(TargetDir)Microsoft.Build.Locator.dll" />
    </ItemGroup>
    <Error
      Condition="'@(_BundledMSBuildRuntime)' != ''"
      Text="MSBuild runtime assemblies must not be copied beside the semantic checker: @(_BundledMSBuildRuntime)" />
  </Target>
</Project>
